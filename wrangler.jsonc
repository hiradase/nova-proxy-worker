{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-worker",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3c14348b-fa72-470f-a3e6-ce22a7d797d3","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6e3556828ad949f0ae6c7fb8fcb75df4" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
